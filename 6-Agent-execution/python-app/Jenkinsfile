pipeline {
    agent { label 'worker-1' }

    stages {
        stage('Clone Github Repository') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/simbudevops/jenkins-shugo.git'
                sh 'pwd'
            }
        }

        stage('Build') {
            steps {
                dir('python-app') {
                    sh 'python3 -m py_compile app.py'
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-app') {
                    sh 'python3 -m unittest discover tests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('python-app') {
                    sh 'docker build -t python-app:latest .'
                }
            }
        }

        stage('Docker Run') {
            steps {
                dir('python-app') {
                    sh 'docker run --rm python-app:latest'
                }
            }
        }

        stage('Docker Tag & Push') {
            steps {
                dir('python-app') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                                      passwordVariable: 'DockerhubPassword',
                                                      usernameVariable: 'DockerhubUserName')]) {
                        sh '''
                            echo "$DockerhubPassword" | docker login -u "$DockerhubUserName" --password-stdin
                            docker tag python-app:latest simbudevops/python-app:latest
                            docker push simbudevops/python-app:latest
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
