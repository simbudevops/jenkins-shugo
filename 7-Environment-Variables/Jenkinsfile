pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', passwordVariable: 'DockerPass', usernameVariable: 'DockerUser')]) {
                    echo "Hello World"
                    echo "Docker username: ${DockerUser}"
                    echo "Running build number: $BUILD_NUMBER"
                    echo "Running build number: #$BUILD_NUMBER and workspace is $WORKSPACE"

                    // Example of using the credentials safely:
                    // sh 'echo "$DockerPass" | docker login -u "$DockerUser" --password-stdin'
                }
            }
        }
    }
}
