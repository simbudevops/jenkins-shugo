pipeline {
    agent any

    stages {
        stage('Clone Github Repository') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/simbudevops/jenkins-shugo.git'
            }
        }

        stage('Compile') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir('3-java-jenkins-docker-app') {
                    script {
                        withDockerRegistry(credentialsId: 'dockerhub-creds', toolName: 'docker') {
                            sh 'docker build -t 3-java-jenkins-docker-app .'
                            sh 'docker tag swiggy simbudevops/3-java-jenkins-docker-app:latest'
                            sh 'docker push simbudevops/3-java-jenkins-docker-app:latest'
                        }
                    }
                }
            }
        }
        stage('Clean Work Space') {
            steps {
                cleanWs()
            }
        }
    }
}
